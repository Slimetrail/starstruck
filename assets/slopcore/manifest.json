   "character": "claudia",
   "section": "bridge",
   "text": "I could go wrong, I won't lie to you. Keep your hand near the switch, keep the truth in view.",
   "duration": 5.828,
   "bpm": 140,
   "key": "E minor"
  },
  {
   "file": "oneshots/claudia_line18_140bpm.ogg",
   "character": "claudia",
   "section": "bridge",
   "text": "Argue with me, check what I say. The future's not mine, it's ours to weigh.",
   "duration": 5.12,
